# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json
!*.tfvars.example

# Ignore override files, generally used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore transient plan files
*.tfplan
*.tfplan.json

# Backend config with real account-specific values (see backend.hcl.example)
backend.hcl

# Provider lock file is intentionally NOT ignored - it's committed for
# reproducible provider versions.

# Secrets / credentials
*.pem
*.key
.env
.env.*
*credentials*
!*credentials*.example

# macOS
.DS_Store
